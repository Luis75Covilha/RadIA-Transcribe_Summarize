# Copy this file to .env and fill in local values.
# Do not commit .env.

OPENAI_API_KEY=replace_with_your_openai_api_key

AUDIO_FOLDER=C:\caminho\para\gravacoes
MAX_FILE_AGE_MINUTES=60

TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=pt
SUMMARY_MODEL=gpt-4o-mini

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=replace_with_your_smtp_password

EMAIL_FROM="Radia <notificacoes@example.com>"
EMAIL_TO=destinatario@example.com

SAVE_RAW_TRANSCRIPT=false
SAVE_SUMMARY=true

PROCESS_FIRST_MINUTES_ONLY=true
FIRST_MINUTES=10
